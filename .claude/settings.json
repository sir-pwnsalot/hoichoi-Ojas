{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npx drizzle-kit *)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(npx tsx *)",
      "Bash(npx shadcn@latest *)",
      "Bash(npx create-next-app@latest *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(npx vercel*)",
      "Bash(vercel *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./API KEYS.md)"
    ]
  }
}
