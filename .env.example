# Copy to .env.local (never commit). No inline comments after values: comments go on their own line.
# Model IDs: run `npm run check:setup -- --models` to list the IDs your keys can actually use.

# --- Text LLMs ---
# Gemini Flash: Bengali + English copy, critic, report
GEMINI_API_KEY=
GEMINI_MODEL_COPY=
# Groq: fast English JSON (plan, image prompts, insight extraction)
GROQ_API_KEY=
GROQ_MODEL_FAST=
# OpenRouter: FALLBACK = a ":free" model; PREMIUM = paid (e.g. a Claude Sonnet model), used only when LLM_TIER=premium
OPENROUTER_API_KEY=
OPENROUTER_MODEL_FALLBACK=
OPENROUTER_MODEL_PREMIUM=
# free | premium
LLM_TIER=free

# --- Images ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# must accept width/height for native 4:5 / 16:9 / 9:16. Fastest: dreamshaper-8-lcm (~4 s).
# Also fine: @cf/bytedance/stable-diffusion-xl-lightning. flux-1-schnell is 1:1 only (rejected).
CF_IMAGE_MODEL=@cf/lykon/dreamshaper-8-lcm
# paid only; leave blank to skip
GEMINI_IMAGE_MODEL=
IMAGE_PROVIDER_ORDER=cloudflare,pollinations,gemini

# --- Budget guard (USD) ---
BUDGET_USD_CAP=20
BUDGET_USD_SOFT=15

# --- Storage / DB ---
# dev: file:local.db   prod: libsql://<db>.turso.io
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=
# Vercel Blob; blank in dev means public/uploads is used
BLOB_READ_WRITE_TOKEN=

# --- Demo ---
DEMO_PASSCODE=
