# Copy to .env.local (never commit). Model IDs are env-driven: check each provider's current model list.

# --- Text LLMs (free tier first) ---
GEMINI_API_KEY=
GEMINI_MODEL_COPY=          # current free Gemini Flash model: Bengali + English copy, critic, report
GROQ_API_KEY=
GROQ_MODEL_FAST=            # fast JSON: creative plan, image prompts, insight extraction
OPENROUTER_API_KEY=
OPENROUTER_MODEL_FALLBACK=  # a ":free" model, used when Gemini is rate-limited
OPENROUTER_MODEL_PREMIUM=   # paid upgrade (e.g. a Claude Sonnet model); used only if LLM_TIER=premium
LLM_TIER=free               # free | premium

# --- Images ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
GEMINI_IMAGE_MODEL=         # paid only; leave blank to skip
IMAGE_PROVIDER_ORDER=cloudflare,pollinations,gemini

# --- Budget guard ---
BUDGET_USD_CAP=20
BUDGET_USD_SOFT=15          # warn in UI above this

# --- Storage / DB ---
DATABASE_URL=file:local.db  # prod: libsql://<db>.turso.io
DATABASE_AUTH_TOKEN=
BLOB_READ_WRITE_TOKEN=      # Vercel Blob; blank in dev → public/uploads

# --- Demo ---
DEMO_PASSCODE=
